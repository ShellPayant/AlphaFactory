# =====================================================================
# AlphaFactory environment variables
# Copy to .env (never commit .env). Required keys depend on the phase.
# =====================================================================

# --- Polygon (historical & realtime US equities data) ---
POLYGON_API_KEY=

# --- Alpaca paper trading ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Alpaca live (DO NOT FILL until live phase) ---
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Risk policy (overrides risk_limits.yaml at runtime) ---
ALPHA_MAX_RISK_PER_TRADE=0.0025          # 0.25%
ALPHA_MAX_DAILY_LOSS=0.01                # 1%
ALPHA_MAX_WEEKLY_LOSS=0.025              # 2.5%
ALPHA_MAX_OPEN_POSITIONS=1
ALPHA_MAX_CORRELATED_POSITIONS=2

# --- Mode selection ---
ALPHA_MODE=research                      # research | paper | live
ALPHA_KILL_SWITCH_ENABLED=true

# --- Paths ---
ALPHA_DATA_ROOT=./data
ALPHA_LOG_ROOT=./logs

# --- Logging ---
ALPHA_LOG_LEVEL=INFO
